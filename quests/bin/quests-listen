#!/usr/bin/env python3
"""quests: start a listener for a chat.

Usage: quests-listen <chat session id> <name> -- <command> [args...]
       quests-listen --stop <listener id>      (ends it for good: no result is sent, it is not started again)

The listener runs as its own user service, <unit prefix>-listen-<id> (quests/INTERFACE.md), so it outlives the chat's process, the page server
and a restart of either. Its output goes to ~/.local/state/quests/listeners/<id>.log. When it ends, the quests
manager sends the chat its exit code and the last lines of the log. After a reboot the manager starts it again, so
the command must be safe to run twice: a loop that polls until the thing it waits for is done.
"""
import os
import shlex
import sqlite3
import subprocess
import sys
import uuid
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from quests_env import current  # noqa: E402
ENV = current()
DB = ENV['DATABASE_PATH']
PREFIX = ENV['QUESTS_UNIT_PREFIX']
LOGS = os.path.expanduser('~/.local/state/quests/listeners')

if len(sys.argv) == 3 and sys.argv[1] == '--stop':
    now = datetime.now(timezone.utc).isoformat()
    db = sqlite3.connect(DB, timeout=30)
    db.execute('UPDATE listeners SET ended_at = ?, exit_code = -1, delivered_at = ? WHERE id = ?', (now, now, sys.argv[2]))
    db.commit()
    subprocess.run(['systemctl', '--user', 'stop', f'{PREFIX}-listen-{sys.argv[2]}.service'])
    sys.exit(0)
if len(sys.argv) < 5 or sys.argv[3] != '--':
    sys.exit(__doc__)
chat, name, command = sys.argv[1], sys.argv[2], sys.argv[4:]
lid = uuid.uuid4().hex[:12]
os.makedirs(LOGS, exist_ok=True)
log = os.path.join(LOGS, f'{lid}.log')
unit = f'{PREFIX}-listen-{lid}'

db = sqlite3.connect(DB, timeout=30)
db.execute('INSERT INTO listeners (id, session_id, name, command, unit, log_path, started_at) VALUES (?, ?, ?, ?, ?, ?, ?)',
           (lid, chat, name, shlex.join(command), unit, log, datetime.now(timezone.utc).isoformat()))
db.commit()
subprocess.run(['systemd-run', '--user', '--collect', '--quiet', '--unit', unit, f'--description=quests listener {name}',
                f'--working-directory={os.getcwd()}', f'--setenv=QUESTS_INSTANCE={ENV["QUESTS_INSTANCE"]}', os.path.join(HERE, 'quests-listen-run'), lid], check=True)
print(f'listener {lid} started as {unit}; log {log}')
