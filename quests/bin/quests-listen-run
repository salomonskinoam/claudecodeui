#!/usr/bin/env python3
"""quests: the body of one listener's service (started by quests-listen, or again by the manager after a reboot).
Runs the recorded command with its output appended to the log, then records the exit code and the end time."""
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone
import os

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib'))
from quests_env import current  # noqa: E402
DB = current()['DATABASE_PATH']
lid = sys.argv[1]
db = sqlite3.connect(DB, timeout=30)
command, log = db.execute('SELECT command, log_path FROM listeners WHERE id = ?', (lid,)).fetchone()
db.close()
with open(log, 'a') as out:
    out.write(f'--- started {datetime.now().isoformat(timespec="seconds")}: {command}\n')
    out.flush()
    code = subprocess.run(['bash', '-lc', command], stdout=out, stderr=subprocess.STDOUT).returncode
db = sqlite3.connect(DB, timeout=30)
db.execute('UPDATE listeners SET ended_at = ?, exit_code = ? WHERE id = ?', (datetime.now(timezone.utc).isoformat(), code, lid))
db.commit()
